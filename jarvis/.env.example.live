# Variables de vision.py (Gemini Live API). Copiá este archivo como .env y completá tu clave.
# Si ya tenés un .env para main.py, agregale solo las líneas que falten: la clave es la misma.
# El .env NUNCA se sube a GitHub.

# --- Clave de API ---
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=


# --- Modelo Live ---
JARVIS_MODELO_LIVE=gemini-3.8-live

# --- Voz de Gemini ---
# Otras: Puck, Charon, Kore, Fenrir, Aoede, Orus, Leda, Achird, Sulafat...
# Lista completa: https://ai.google.dev/gemini-api/docs/speech-generation
JARVIS_VOZ_LIVE=Zephyr

# --- Detección de voz ---
# Milisegundos de silencio para dar por terminado lo que decís. Subilo si te corta
# cuando hacés una pausa para pensar (la documentación recomienda 500-800).
JARVIS_VAD_SILENCIO_MS=700
# Milisegundos de audio previos que se guardan cuando empezás a hablar.
JARVIS_VAD_PREFIJO_MS=300

# --- Búsqueda de Google ---
# Apagada por defecto. Tiene su propia cuota: si está agotada (pasa seguido en el nivel
# gratuito), la conexión entera falla con "cuota agotada". También se prende con --con-busqueda.
JARVIS_BUSQUEDA=false

# --- Opciones de la Live API no soportadas (o sin confirmar) en gemini-3.8-live ---
# Apagadas (false). Se pueden probar con true si cambiás de modelo; si el modelo no las
# acepta, vision.py avisa al conectar cuál es y cómo apagarla.
# Diálogo afectivo: adapta el tono a cómo le hablás. Sin confirmar en gemini-3.8-live.
JARVIS_AFECTIVO=false
# Audio proactivo: no contesta si no le hablan a ella. gemini-3.8-live lo rechaza
# (error 1007: Unknown name "proactivity").
JARVIS_PROACTIVO=false
