# Copiá este archivo como .env y completá tu clave. El .env NUNCA se sube a GitHub.

# --- Qué IA usar (cambiá solo esta línea para cambiar de IA) ---
JARVIS_MODELO=gemini/gemini-flash-latest
# JARVIS_MODELO=anthropic/claude-sonnet-5-5

# --- Claves de API ---
# Gemini: gratis para empezar en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Voz ---
JARVIS_NOMBRE=jarvis
JARVIS_IDIOMA=es-AR
# pyttsx3 = sin internet | edge = voz más natural
JARVIS_MOTOR_VOZ=pyttsx3
JARVIS_VOZ_EDGE=es-AR-TomasNeural
JARVIS_SEGUNDOS_CONVERSACION=30
