# Copiá este archivo como .env y completá tu clave. El .env NUNCA se sube a GitHub.

# --- Qué IA usar (cambiá solo esta línea para cambiar de IA) ---
JARVIS_MODELO=gemini/gemini-flash-latest
# JARVIS_MODELO=anthropic/claude-sonnet-5-5

# --- Claves de API ---
# Gemini: gratis para empezar en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
# GitHub (opcional, para analizar repositorios, issues, PRs y commits): https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Voz ---
JARVIS_NOMBRE=jarvis
JARVIS_IDIOMA=es-AR
# pyttsx3 = sin internet | edge = voz más natural
JARVIS_MOTOR_VOZ=pyttsx3
JARVIS_VOZ_EDGE=es-AR-TomasNeural
JARVIS_SEGUNDOS_CONVERSACION=30

# --- Máquina Virtual por SSH (GNU Health / Linux) ---
VM_SSH_HOST=192.168.100.24
VM_SSH_PORT=22
VM_SSH_USER=gnuhealth
VM_SSH_PASSWORD=

# --- Gemini web en Microsoft Edge (cerebro principal, usa tu cuenta de Gemini Pro) ---
# Jarvis se conecta por CDP a Edge; si no está abierto lo lanza con este perfil propio.
JARVIS_GEMINI_WEB=true
JARVIS_EDGE_CDP=http://127.0.0.1:9222
JARVIS_EDGE_PERFIL=C:\EdgeJarvisProfile
